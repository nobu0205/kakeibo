<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Kakeibo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 dark:bg-gray-900 dark:text-white transition-colors duration-300">

    <!-- ヘッダー -->
    <div class="bg-white dark:bg-gray-800 shadow px-6 py-4 transition-colors duration-300">
      <div class="max-w-4xl mx-auto flex justify-between items-center">

        <h1 class="text-xl font-bold dark:text-white">
          家計簿アプリ
        </h1>

        <div class="flex gap-4 items-center">

          <button
  id="theme-toggle"
  class="px-3 py-1 rounded-lg bg-gray-200 dark:bg-gray-700"
>
  🌙
</button>

          <% if user_signed_in? %>

            <span class="text-gray-600 dark:text-gray-300">
              <%= current_user.email %>
            </span>

            <%= link_to "ログアウト",
              destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "text-red-500 hover:underline" %>

          <% else %>

            <%= link_to "ログイン",
              new_user_session_path,
              class: "text-blue-500 hover:underline" %>

            <%= link_to "新規登録",
              new_user_registration_path,
              class: "text-green-500 hover:underline" %>

              <%= button_to "ゲストログイン",
  users_guest_sign_in_path,
  method: :post,
  form: { data: { turbo: false } },
  class: "text-purple-500 hover:underline bg-transparent border-0 cursor-pointer" %>

          <% end %>

        </div>

      </div>
    </div>

    <div class="max-w-4xl mx-auto p-6">

      <% if notice %>

        <div class="mb-6 bg-green-100 border border-green-300
                    text-green-800 px-4 py-3 rounded-xl shadow">
          <%= notice %>
        </div>

      <% end %>

      <% if alert %>

        <div class="mb-6 bg-red-100 border border-red-300
                    text-red-800 px-4 py-3 rounded-xl shadow">
          <%= alert %>
        </div>

      <% end %>

      <%= yield %>

    </div>

    <script>
document.addEventListener("turbo:load", () => {
  const html = document.documentElement;
  const button = document.getElementById("theme-toggle");

  if (localStorage.theme === "dark") {
    html.classList.add("dark");
    if (button) button.textContent = "☀️";
  }

  if (button) {
    button.addEventListener("click", () => {
      html.classList.toggle("dark");

      if (html.classList.contains("dark")) {
        localStorage.theme = "dark";
        button.textContent = "☀️";
      } else {
        localStorage.theme = "light";
        button.textContent = "🌙";
      }

      setTimeout(() => {
        if (typeof renderCharts === "function") {
          renderCharts();
        }
      }, 50);
    });
  }
});
</script>
