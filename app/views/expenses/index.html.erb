<h1 class="text-3xl font-bold mb-6">家計簿</h1>

<div class="flex items-center justify-center gap-4 mb-6">

  <%= link_to "←",
    expenses_path(
      month: @selected_month.prev_month.strftime("%Y-%m"),
      category: params[:category],
      keyword: params[:keyword],
      sort: params[:sort]
    ),
    class: "bg-white px-3 py-1 rounded shadow hover:bg-gray-100" %>

  <h2 class="text-xl font-bold">
    <%= @selected_month.strftime("%Y年%m月") %>
  </h2>

  <%= link_to "→",
    expenses_path(
      month: @selected_month.next_month.strftime("%Y-%m"),
      category: params[:category],
      keyword: params[:keyword],
      sort: params[:sort]
    ),
    class: "bg-white px-3 py-1 rounded shadow hover:bg-gray-100" %>

</div>

<form method="get"
      class="mb-6 flex flex-col md:flex-row gap-2 bg-white p-4 rounded-xl shadow">

  <input type="hidden"
         name="month"
         value="<%= @selected_month.strftime("%Y-%m") %>">

  <!-- キーワード -->
  <input
    type="text"
    name="keyword"
    value="<%= params[:keyword] %>"
    placeholder="タイトル検索"
    class="border rounded p-2 flex-1"
  />

  <!-- カテゴリ -->
  <select name="category" class="border rounded p-2">

    <option value="">すべて</option>

    <option value="食費"
      <%= "selected" if params[:category] == "食費" %>>
      食費
    </option>

    <option value="交通費"
      <%= "selected" if params[:category] == "交通費" %>>
      交通費
    </option>

    <option value="娯楽"
      <%= "selected" if params[:category] == "娯楽" %>>
      娯楽
    </option>

    <option value="その他"
      <%= "selected" if params[:category] == "その他" %>>
      その他
    </option>

  </select>

 <!-- 並び替え -->
<select name="sort"
        class="border rounded p-2"
        onchange="this.form.submit()">

  <option value="">並び替え</option>

  <option value="latest"
    <%= "selected" if params[:sort] == "latest" %>>
    新しい順
  </option>

  <option value="old"
    <%= "selected" if params[:sort] == "old" %>>
    古い順
  </option>

  <option value="amount_desc"
    <%= "selected" if params[:sort] == "amount_desc" %>>
    金額高い順
  </option>

  <option value="amount_asc"
    <%= "selected" if params[:sort] == "amount_asc" %>>
    金額低い順
  </option>

</select>

  <!-- ボタン -->
  <button type="submit"
          class="bg-gray-800 text-white px-3 py-2 rounded hover:bg-gray-700">
    絞り込み
  </button>

  <%= link_to "リセット",
    expenses_path,
    class: "text-sm text-blue-500 ml-2" %>

</form>

<p class="text-xl mb-6">

  合計:
  <span class="font-semibold">
    <%= number_to_currency(
      @total_amount,
      unit: "",
      delimiter: ","
    ) %>
  </span>
  円

</p>

<!-- 統計カード -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

  <!-- 今月合計 -->
  <div class="bg-white rounded-xl shadow p-4
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <p class="text-sm text-gray-500 mb-1">
      今月の支出
    </p>

    <p class="text-2xl font-bold text-blue-600">
      <%= number_to_currency(
        @month_total,
        unit: "",
        delimiter: ","
      ) %> 円
    </p>

  </div>

  <!-- 件数 -->
  <div class="bg-white rounded-xl shadow p-4
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <p class="text-sm text-gray-500 mb-1">
      今月の登録数
    </p>

    <p class="text-2xl font-bold text-green-600">
      <%= @month_count %> 件
    </p>

  </div>

  <!-- 最大支出 -->
  <div class="bg-white rounded-xl shadow p-4
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <p class="text-sm text-gray-500 mb-1">
      最大支出
    </p>

    <p class="text-2xl font-bold text-red-500">
      <%= number_to_currency(
        @max_expense,
        unit: "",
        delimiter: ","
      ) %> 円
    </p>

  </div>

</div>

<!-- グラフ -->
<div class="grid md:grid-cols-2 gap-6 mb-6">

  <!-- カテゴリ -->
  <div class="bg-white p-4 rounded-xl shadow
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <h2 class="text-lg font-semibold mb-2">
      カテゴリ別
    </h2>

    <canvas id="categoryChart"></canvas>

  </div>

  <!-- 月別 -->
  <div class="bg-white p-4 rounded-xl shadow
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <h2 class="text-lg font-semibold mb-2">
      月別支出
    </h2>

    <canvas id="monthlyChart"></canvas>

  </div>

</div>

<!-- カテゴリ割合 -->
<div class="bg-white p-6 rounded-2xl shadow mb-6
            hover:shadow-xl transition duration-300">

  <h2 class="text-lg font-semibold mb-4">
    カテゴリ割合
  </h2>

  <% @category_totals.each do |category, amount| %>

    <% percentage =
      @total_amount > 0 ?
      ((amount.to_f / @total_amount) * 100).round : 0
    %>

    <div class="mb-5">

      <!-- ラベル -->
      <div class="flex justify-between items-center mb-2">

        <div class="flex items-center gap-2">

          <div class="
            w-3 h-3 rounded-full
            <%= case category
                when '食費' then 'bg-green-500'
                when '交通費' then 'bg-blue-500'
                when '娯楽' then 'bg-purple-500'
                else 'bg-gray-500'
                end %>
          "></div>

          <span class="font-medium">
            <%= category %>
          </span>

        </div>

        <span class="text-sm text-gray-500">

          <%= percentage %>% ・

          <%= number_to_currency(
            amount,
            unit: "",
            delimiter: ","
          ) %>円

        </span>

      </div>

      <!-- バー -->
      <div class="w-full bg-gray-200 rounded-full h-5 overflow-hidden">

        <div
          class="
            h-5 rounded-full
            transition-all duration-700
            hover:brightness-110
            <%= case category
                when '食費' then 'bg-green-500'
                when '交通費' then 'bg-blue-500'
                when '娯楽' then 'bg-purple-500'
                else 'bg-gray-500'
                end %>
          "
          style="width: <%= percentage %>%"
        ></div>

      </div>

    </div>

  <% end %>

</div>

<!-- 新規追加 -->
<%= link_to "＋ 支出を追加",
  new_expense_path,
  class: "inline-block bg-blue-500 text-white
          px-4 py-2 rounded shadow
          hover:bg-blue-600 mb-6" %>

<%= link_to "CSVダウンロード",
    expenses_path(
      format: :csv,
      month: params[:month],
      category: params[:category],
      keyword: params[:keyword],
      sort: params[:sort]
    ),
    class: "inline-block bg-green-500 text-white
            px-4 py-2 rounded shadow
            hover:bg-green-600 mb-6 ml-2" %>

<!-- 一覧 -->
<% if @expenses.any? %>

  <div class="space-y-4">

    <% @expenses.each do |expense| %>

      <div class="bg-white p-4 rounded-xl shadow
                  hover:shadow-xl hover:-translate-y-1
                  transition duration-300
                  flex flex-col sm:flex-row
                  sm:justify-between sm:items-center
                  gap-3">

        <!-- 左 -->
        <div>

          <p class="font-semibold">
            <%= expense.title %>
          </p>

          <p class="text-sm mt-1">

            <span class="
              px-2 py-1 rounded text-white text-xs
              <%= case expense.category
                  when '食費' then 'bg-green-500'
                  when '交通費' then 'bg-blue-500'
                  when '娯楽' then 'bg-purple-500'
                  else 'bg-gray-500'
                  end %>
            ">
              <%= expense.category %>
            </span>

            <span class="text-gray-500 ml-2">
              <%= expense.date %>
            </span>

          </p>

        </div>

        <!-- 右 -->
        <div class="sm:text-right">

          <p class="font-bold text-lg">
            <%= number_to_currency(
              expense.amount,
              unit: "",
              delimiter: ","
            ) %> 円
          </p>

          <div class="mt-2 flex gap-2 sm:justify-end">

            <%= link_to "詳細",
              expense,
              class: "bg-blue-100 text-blue-600
                      px-3 py-1 rounded-lg text-sm
                      hover:bg-blue-200 transition" %>

            <%= link_to "編集",
              edit_expense_path(expense),
              class: "bg-green-100 text-green-600
                      px-3 py-1 rounded-lg text-sm
                      hover:bg-green-200 transition" %>

            <%= link_to "削除",
              expense,
              data: {
                turbo_method: :delete,
                turbo_confirm: "削除しますか？"
              },
              class: "bg-red-100 text-red-600
                      px-3 py-1 rounded-lg text-sm
                      hover:bg-red-200 transition" %>

          </div>

        </div>

      </div>

    <% end %>

  </div>

<% else %>

  <!-- 空状態 -->
  <div class="bg-white rounded-xl shadow p-10 text-center">

    <p class="text-5xl mb-4">
      💰
    </p>

    <h2 class="text-xl font-semibold mb-2">
      まだ支出がありません
    </h2>

    <p class="text-gray-500 mb-6">
      最初の支出を登録してみましょう
    </p>

    <%= link_to "＋ 支出を追加",
      new_expense_path,
      class: "inline-block bg-blue-500 text-white
              px-4 py-2 rounded hover:bg-blue-600" %>

  </div>

<% end %>

<script>
  function drawChart() {
    const ctx = document.getElementById('categoryChart');
    if (!ctx) return;

    if (
      window.categoryChart &&
      typeof window.categoryChart.destroy === "function"
    ) {
      window.categoryChart.destroy();
    }

    const data = {
      labels: <%= raw @category_totals.keys.to_json %>,
      datasets: [{
        label: '支出',
        data: <%= raw @category_totals.values.to_json %>,
        backgroundColor: [
          '#22C55E',
          '#3B82F6',
          '#A855F7',
          '#6B7280'
        ]
      }]
    };

    window.categoryChart = new Chart(ctx, {
      type: 'pie',
      data: data
    });
  }

  function drawMonthlyChart() {
    const ctx = document.getElementById('monthlyChart');
    if (!ctx) return;

    if (
      window.monthlyChart &&
      typeof window.monthlyChart.destroy === "function"
    ) {
      window.monthlyChart.destroy();
    }

    const data = {
      labels: <%= raw @monthly_totals.keys.map { |d|
        d.strftime("%Y-%m")
      }.to_json %>,

      datasets: [{
        label: '月別支出',
        data: <%= raw @monthly_totals.values.to_json %>,
        borderColor: '#3B82F6',
        backgroundColor: '#93C5FD',
        tension: 0.3,
        fill: true
      }]
    };

    window.monthlyChart = new Chart(ctx, {
      type: 'line',
      data: data
    });
  }

  document.addEventListener("turbo:load", drawChart);
  document.addEventListener("turbo:load", drawMonthlyChart);
</script>