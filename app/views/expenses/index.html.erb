<h1 class="text-3xl font-bold mb-6">家計簿</h1>

<form method="get" class="mb-6 flex items-center gap-2">

  <select name="category" class="border rounded p-2">
    <option value="">すべて</option>
    <option value="食費" <%= "selected" if params[:category] == "食費" %>>食費</option>
    <option value="交通費" <%= "selected" if params[:category] == "交通費" %>>交通費</option>
    <option value="娯楽" <%= "selected" if params[:category] == "娯楽" %>>娯楽</option>
    <option value="その他" <%= "selected" if params[:category] == "その他" %>>その他</option>
  </select>

  <button type="submit"
    class="bg-gray-800 text-white px-3 py-2 rounded">
    絞り込み
  </button>

  <!-- リセット -->
  <%= link_to "リセット", expenses_path,
    class: "text-sm text-blue-500 ml-2" %>

</form>

<p class="text-xl mb-6">
  合計:
  <span class="font-semibold">
    <%= number_to_currency(@total_amount, unit: "", delimiter: ",") %>
  </span> 円
</p>

<!-- グラフエリア -->
<div class="grid md:grid-cols-2 gap-6 mb-6">

  <!-- カテゴリ -->
  <div class="bg-white shadow rounded-xl p-4">
    <h2 class="text-lg font-semibold mb-2">カテゴリ別</h2>
    <canvas id="categoryChart"></canvas>
  </div>

  <!-- 月別 -->
  <div class="bg-white shadow rounded-xl p-4">
    <h2 class="text-lg font-semibold mb-2">月別支出</h2>
    <canvas id="monthlyChart"></canvas>
  </div>

</div>

<!-- 新規ボタン -->
<%= link_to "＋ 支出を追加", new_expense_path,
  class: "inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 mb-6" %>

<!-- 一覧 -->
<div class="space-y-4">
  <% @expenses.each do |expense| %>
    <div class="bg-white p-4 rounded-xl shadow flex justify-between items-center">
      <div>
        <p class="font-semibold"><%= expense.title %></p>
        <p class="text-sm text-gray-500">
          <%= expense.category %> / <%= expense.date %>
        </p>
      </div>

      <div class="text-right">
        <p class="font-bold text-lg">
  <%= number_to_currency(expense.amount, unit: "", delimiter: ",") %> 円
</p>
        <%= link_to "詳細", expense, class: "text-blue-500 text-sm" %>
        <%= link_to "削除", expense,
        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
        class: "text-red-500 text-sm ml-2" %>
      </div>
    </div>
  <% end %>
</div>

<script>
  function drawChart() {
    const ctx = document.getElementById('categoryChart');
    if (!ctx) return;

    if (window.categoryChart && typeof window.categoryChart.destroy === "function") {
      window.categoryChart.destroy();
    }

    const data = {
      labels: <%= raw @category_totals.keys.to_json %>,
      datasets: [{
        label: '支出',
        data: <%= raw @category_totals.values.to_json %>,
        backgroundColor: ['#FF6384','#36A2EB','#FFCE56']
      }]
    };

    window.categoryChart = new Chart(ctx, {
      type: 'pie',
      data: data
    });
  }

  function drawMonthlyChart() {
    const ctx = document.getElementById('monthlyChart');
    if (!ctx) return;

    if (window.monthlyChart && typeof window.monthlyChart.destroy === "function") {
      window.monthlyChart.destroy();
    }

    const data = {
      labels: <%= raw @monthly_totals.keys.map { |d| d.strftime("%Y-%m") }.to_json %>,
      datasets: [{
        label: '月別支出',
        data: <%= raw @monthly_totals.values.to_json %>,
        borderColor: '#36A2EB',
        fill: false
      }]
    };

    window.monthlyChart = new Chart(ctx, {
      type: 'line',
      data: data
    });
  }

  document.addEventListener("turbo:load", drawChart);
  document.addEventListener("turbo:load", drawMonthlyChart);
</script>