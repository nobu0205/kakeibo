<h1 class="text-3xl font-bold mb-6">家計簿</h1>

<!-- 月切り替え -->
<div class="flex items-center justify-center gap-4 mb-6">

  <%= link_to "←",
    expenses_path(
      month: @selected_month.prev_month.strftime("%Y-%m"),
      category: params[:category],
      keyword: params[:keyword],
      sort: params[:sort]
    ),
    class: "bg-white px-3 py-1 rounded shadow hover:bg-gray-100 transition" %>

  <h2 class="text-xl font-bold">
    <%= @selected_month.strftime("%Y年%m月") %>
  </h2>

  <%= link_to "→",
    expenses_path(
      month: @selected_month.next_month.strftime("%Y-%m"),
      category: params[:category],
      keyword: params[:keyword],
      sort: params[:sort]
    ),
    class: "bg-white px-3 py-1 rounded shadow hover:bg-gray-100 transition" %>

</div>

<!-- 検索 -->
<form method="get"
      class="mb-6 flex flex-col md:flex-row gap-2 bg-white p-4 rounded-xl shadow">

  <input type="hidden"
         name="month"
         value="<%= @selected_month.strftime("%Y-%m") %>">

  <!-- キーワード -->
  <input
    type="text"
    name="keyword"
    value="<%= params[:keyword] %>"
    placeholder="タイトル検索"
    class="border rounded p-2 flex-1"
  />

  <!-- カテゴリ -->
  <select name="category" class="border rounded p-2">

    <option value="">すべて</option>

    <% ["食費", "交通費", "娯楽", "その他"].each do |category| %>

      <option value="<%= category %>"
        <%= "selected" if params[:category] == category %>>
        <%= category %>
      </option>

    <% end %>

  </select>

  <!-- 並び替え -->
  <select name="sort"
          class="border rounded p-2"
          onchange="this.form.submit()">

    <option value="">並び替え</option>

    <option value="latest"
      <%= "selected" if params[:sort] == "latest" %>>
      新しい順
    </option>

    <option value="old"
      <%= "selected" if params[:sort] == "old" %>>
      古い順
    </option>

    <option value="amount_desc"
      <%= "selected" if params[:sort] == "amount_desc" %>>
      金額高い順
    </option>

    <option value="amount_asc"
      <%= "selected" if params[:sort] == "amount_asc" %>>
      金額低い順
    </option>

  </select>

  <!-- ボタン -->
  <button type="submit"
          class="bg-gray-800 text-white px-3 py-2 rounded hover:bg-gray-700 transition">
    絞り込み
  </button>

  <%= link_to "リセット",
    expenses_path,
    class: "text-sm text-blue-500 ml-2 self-center hover:underline" %>

</form>

<!-- 合計 -->
<p class="text-xl mb-6">

  合計:
  <span class="font-semibold">
    <%= number_to_currency(
      @total_amount,
      unit: "",
      delimiter: ","
    ) %>
  </span>
  円

</p>

<!-- 予算進捗 -->
<% budget = current_user.budgets.find_by(
     month: @selected_month.beginning_of_month
   ) || current_user.budgets.where(
     month: @selected_month.beginning_of_month..@selected_month.end_of_month
   ).first %>

<% if budget %>

  <% progress = (
       (@month_total.to_f / budget.amount) * 100
     ).round %>

  <div class="bg-white rounded-2xl shadow p-6 mb-6">

    <div class="flex justify-between items-center mb-2">

      <h2 class="text-lg font-semibold">
        今月の予算
      </h2>

      <span class="
        <%= progress > 100 ?
            'text-red-500' :
            'text-green-600' %>
        font-bold
      ">
        <%= progress %>%
      </span>

    </div>

    <p class="text-gray-600 mb-3">

      <%= number_to_currency(
        @month_total,
        unit: "",
        delimiter: ","
      ) %> 円

      /

      <%= number_to_currency(
        budget.amount,
        unit: "",
        delimiter: ","
      ) %> 円

    </p>

    <div class="w-full bg-gray-200 rounded-full h-5 overflow-hidden">

      <div
        class="
          <%= progress > 100 ?
              'bg-red-500' :
              'bg-purple-500' %>
          h-5 rounded-full transition-all duration-700
        "
        style="width: <%= [progress, 100].min %>%">
      </div>

    </div>

    <% if progress > 100 %>

      <p class="text-red-500 text-sm mt-2">
        予算をオーバーしています
      </p>

    <% end %>

  </div>

<% end %>

<!-- 統計カード -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

  <!-- 今月合計 -->
  <div class="bg-white rounded-xl shadow p-4
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <p class="text-sm text-gray-500 mb-1">
      今月の支出
    </p>

    <p class="text-2xl font-bold text-blue-600">

      <%= number_to_currency(
        @month_total,
        unit: "",
        delimiter: ","
      ) %> 円

    </p>

  </div>

  <!-- 件数 -->
  <div class="bg-white rounded-xl shadow p-4
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <p class="text-sm text-gray-500 mb-1">
      今月の登録数
    </p>

    <p class="text-2xl font-bold text-green-600">
      <%= @month_count %> 件
    </p>

  </div>

  <!-- 最大支出 -->
  <div class="bg-white rounded-xl shadow p-4
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <p class="text-sm text-gray-500 mb-1">
      最大支出
    </p>

    <p class="text-2xl font-bold text-red-500">

      <%= number_to_currency(
        @max_expense,
        unit: "",
        delimiter: ","
      ) %> 円

    </p>

  </div>

</div>

<!-- カレンダー -->
<div class="bg-white p-6 rounded-2xl shadow mb-6
            hover:shadow-xl transition duration-300">

  <h2 class="text-lg font-semibold mb-4">
    カレンダー
  </h2>

  <%= month_calendar events: @expenses do |date, expenses| %>

    <div class="h-[140px] p-1 overflow-y-auto">

      <!-- 日付 -->
      <div class="text-sm font-bold mb-2">
        <%= date.day %>
      </div>

      <!-- 支出 -->
      <% expenses.each do |expense| %>

        <%= link_to expense_path(expense),
    class: "block no-underline" do %>

          <div class="
            text-xs rounded-lg p-2 mb-1 text-white shadow-sm
            hover:brightness-110 transition

            <%= case expense.category
                when '食費' then 'bg-green-500'
                when '交通費' then 'bg-blue-500'
                when '娯楽' then 'bg-purple-500'
                else 'bg-gray-500'
                end %>
          ">

            <div class="font-semibold truncate">
              <%= expense.title %>
            </div>

            <div class="text-[10px] opacity-90">

              <%= number_to_currency(
                expense.amount,
                unit: "",
                delimiter: ","
              ) %>円

            </div>

          </div>

        <% end %>

      <% end %>

      <!-- 日別合計 -->
      <% if expenses.any? %>

        <div class="text-xs text-gray-500 mt-2">

          合計:

          <%= number_to_currency(
            expenses.sum(&:amount),
            unit: "",
            delimiter: ","
          ) %>円

        </div>

      <% end %>

    </div>

  <% end %>

</div>

<!-- グラフ -->
<div class="grid md:grid-cols-2 gap-6 mb-6">

  <!-- カテゴリ -->
  <div class="bg-white p-4 rounded-xl shadow
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <h2 class="text-lg font-semibold mb-2">
      カテゴリ別
    </h2>

    <div class="h-72">
  <canvas id="categoryChart"></canvas>
</div>

  </div>

  <!-- 月別 -->
  <div class="bg-white p-4 rounded-xl shadow
              hover:shadow-xl hover:-translate-y-1
              transition duration-300">

    <h2 class="text-lg font-semibold mb-2">
      月別支出
    </h2>

    <div class="h-72">
  <canvas id="monthlyChart"></canvas>
</div>

  </div>

</div>

<!-- カテゴリ割合 -->
<div class="bg-white p-6 rounded-2xl shadow mb-6
            hover:shadow-xl transition duration-300">

  <h2 class="text-lg font-semibold mb-4">
    カテゴリ割合
  </h2>

  <% @category_totals.each do |category, amount| %>

    <% percentage =
      @total_amount > 0 ?
      ((amount.to_f / @total_amount) * 100).round : 0
    %>

    <div class="mb-5">

      <!-- ラベル -->
      <div class="flex justify-between items-center mb-2">

        <div class="flex items-center gap-2">

          <div class="
            w-3 h-3 rounded-full

            <%= case category
                when '食費' then 'bg-green-500'
                when '交通費' then 'bg-blue-500'
                when '娯楽' then 'bg-purple-500'
                else 'bg-gray-500'
                end %>
          "></div>

          <span class="font-medium">
            <%= category %>
          </span>

        </div>

        <span class="text-sm text-gray-500">

          <%= percentage %>% ・

          <%= number_to_currency(
            amount,
            unit: "",
            delimiter: ","
          ) %>円

        </span>

      </div>

      <!-- バー -->
      <div class="w-full bg-gray-200 rounded-full h-5 overflow-hidden">

        <div
          class="
            h-5 rounded-full transition-all duration-700
            hover:brightness-110

            <%= case category
                when '食費' then 'bg-green-500'
                when '交通費' then 'bg-blue-500'
                when '娯楽' then 'bg-purple-500'
                else 'bg-gray-500'
                end %>
          "
          style="width: <%= percentage %>%"
        ></div>

      </div>

    </div>

  <% end %>

</div>

<!-- ボタン -->
<div class="mb-6 flex flex-col sm:flex-row gap-2">

  <%= link_to "＋ 支出を追加",
    new_expense_path,
    class: "inline-block bg-blue-500 text-white
            px-4 py-2 rounded shadow
            hover:bg-blue-600 transition" %>


       <%= link_to "予算設定",
    new_budget_path,
    class: "inline-block bg-purple-500 text-white
            px-4 py-2 rounded shadow
            hover:bg-purple-600 transition" %>       

  <%= link_to "CSVダウンロード",
      expenses_path(
        format: :csv,
        month: params[:month],
        category: params[:category],
        keyword: params[:keyword],
        sort: params[:sort]
      ),
      class: "inline-block bg-green-500 text-white
              px-4 py-2 rounded shadow
              hover:bg-green-600 transition ml-2" %>

</div>

<!-- 一覧 -->
<% if @expenses.any? %>

  <div class="space-y-4">

    <% @expenses.each do |expense| %>

      <div class="bg-white p-4 rounded-xl shadow
                  hover:shadow-xl hover:-translate-y-1
                  transition duration-300
                  flex flex-col sm:flex-row
                  sm:justify-between sm:items-center
                  gap-3">

        <!-- 左 -->
        <div>

          <p class="font-semibold">
            <%= expense.title %>
          </p>

          <p class="text-sm mt-1">

            <span class="
              px-2 py-1 rounded text-white text-xs

              <%= case expense.category
                  when '食費' then 'bg-green-500'
                  when '交通費' then 'bg-blue-500'
                  when '娯楽' then 'bg-purple-500'
                  else 'bg-gray-500'
                  end %>
            ">
              <%= expense.category %>
            </span>

            <span class="text-gray-500 ml-2">
              <%= expense.date.strftime("%Y/%m/%d") %>
            </span>

          </p>

        </div>

        <!-- 右 -->
        <div class="sm:text-right">

          <p class="font-bold text-lg">

            <%= number_to_currency(
              expense.amount,
              unit: "",
              delimiter: ","
            ) %> 円

          </p>

          <div class="mt-2 flex gap-2 sm:justify-end">

            <%= link_to "詳細",
              expense,
              class: "bg-blue-100 text-blue-600
                      px-3 py-1 rounded-lg text-sm
                      hover:bg-blue-200 transition" %>

            <%= link_to "編集",
              edit_expense_path(expense),
              class: "bg-green-100 text-green-600
                      px-3 py-1 rounded-lg text-sm
                      hover:bg-green-200 transition" %>

            <%= link_to "削除",
              expense,
              data: {
                turbo_method: :delete,
                turbo_confirm: "削除しますか？"
              },
              class: "bg-red-100 text-red-600
                      px-3 py-1 rounded-lg text-sm
                      hover:bg-red-200 transition" %>

          </div>

        </div>

      </div>

    <% end %>

  </div>

<% else %>

  <!-- 空状態 -->
  <div class="bg-white rounded-xl shadow p-10 text-center">

    <p class="text-5xl mb-4">
      💰
    </p>

    <h2 class="text-xl font-semibold mb-2">
      まだ支出がありません
    </h2>

    <p class="text-gray-500 mb-6">
      最初の支出を登録してみましょう
    </p>

    <%= link_to "＋ 支出を追加",
      new_expense_path,
      class: "inline-block bg-blue-500 text-white
              px-4 py-2 rounded hover:bg-blue-600 transition" %>

  </div>

<% end %>

<script>
  function drawChart() {
    const ctx = document.getElementById('categoryChart');
    if (!ctx) return;

    // 既存グラフ削除
    if (
      window.categoryChart &&
      typeof window.categoryChart.destroy === "function"
    ) {
      window.categoryChart.destroy();
    }

    const data = {
      labels: <%= raw @category_totals.keys.to_json %>,
      datasets: [{
        label: '支出',
        data: <%= raw @category_totals.values.to_json %>,
        backgroundColor: [
          '#22C55E',
          '#3B82F6',
          '#A855F7',
          '#6B7280'
        ]
      }]
    };

    // 円グラフ
    window.categoryChart = new Chart(ctx, {
      type: 'pie',
      data: data,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom'
          }
        }
      }
    });
  }

  function drawMonthlyChart() {
    const ctx = document.getElementById('monthlyChart');
    if (!ctx) return;

    // 既存グラフ削除
    if (
      window.monthlyChart &&
      typeof window.monthlyChart.destroy === "function"
    ) {
      window.monthlyChart.destroy();
    }

    const data = {
      labels: <%= raw @monthly_totals.keys.map { |d|
        d.strftime("%Y-%m")
      }.to_json %>,

      datasets: [{
        label: '月別支出',
        data: <%= raw @monthly_totals.values.to_json %>,
        borderColor: '#3B82F6',
        backgroundColor: '#93C5FD',
        tension: 0.3,
        fill: true
      }]
    };

    // 折れ線グラフ
    window.monthlyChart = new Chart(ctx, {
      type: 'line',
      data: data,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom'
          }
        }
      }
    });
  }

  document.addEventListener("turbo:load", () => {
    drawChart();
    drawMonthlyChart();
  });
</script>