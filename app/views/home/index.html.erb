<div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50">

  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-6 py-24 text-center">

    <p class="text-blue-600 font-semibold mb-4 tracking-wide">
      Smart Expense Tracker
    </p>

    <h1 class="text-6xl font-bold text-gray-900 leading-tight mb-6">
      家計管理を<br>
      もっとシンプルに
    </h1>

    <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-10">
      毎日の支出を記録し、グラフで可視化。<br>
      シンプルで直感的な家計簿アプリ。
    </p>

   <div class="flex flex-col items-center gap-5">

  <%= link_to "新規登録",
    new_user_registration_path,
    class: "w-72 h-14 flex items-center justify-center rounded-2xl bg-white border-2 border-gray-900 text-gray-900 font-semibold shadow-xl hover:bg-gray-900 hover:text-white transition-all duration-300" %>

  <%= link_to "ログイン",
    new_user_session_path,
    class: "w-72 h-14 flex items-center justify-center rounded-2xl bg-white border-2 border-gray-400 text-gray-800 font-semibold shadow hover:border-gray-700 transition-all duration-300" %>

  <%= button_to "ゲストログイン",
    users_guest_sign_in_path,
    method: :post,
    form: {
      data: { turbo: false },
      class: "w-72"
    },
    class: "w-full h-14 rounded-2xl bg-purple-100 border-2 border-purple-500 text-purple-700 font-semibold shadow hover:bg-purple-200 transition-all duration-300 border-0 cursor-pointer" %>

</div>

</div>

  </section>

  <!-- Features -->
  <section class="max-w-6xl mx-auto px-6 pb-24">

    <div class="grid md:grid-cols-3 gap-8">

      <div class="bg-white/80 backdrop-blur rounded-3xl p-8 shadow-lg hover:-translate-y-2 transition duration-300">
        <div class="text-5xl mb-4">📊</div>
        <h2 class="text-2xl font-bold mb-3">グラフ分析</h2>
        <p class="text-gray-600">
          カテゴリ別・月別に支出を可視化して、お金の流れを把握。
        </p>
      </div>

      <div class="bg-white/80 backdrop-blur rounded-3xl p-8 shadow-lg hover:-translate-y-2 transition duration-300">
        <div class="text-5xl mb-4">📅</div>
        <h2 class="text-2xl font-bold mb-3">カレンダー管理</h2>
        <p class="text-gray-600">
          日付ごとの支出をカレンダーで確認。
        </p>
      </div>

      <div class="bg-white/80 backdrop-blur rounded-3xl p-8 shadow-lg hover:-translate-y-2 transition duration-300">
        <div class="text-5xl mb-4">⬇️</div>
        <h2 class="text-2xl font-bold mb-3">CSV出力</h2>
        <p class="text-gray-600">
          データをダウンロードして分析や管理に活用。
        </p>
      </div>

    </div>

  </section>

</div>
